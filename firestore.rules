rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    
    // Check if request data has required fields
    function hasRequired(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // Validate timestamp fields
    function isValidTimestamp() {
      return request.resource.data.createdAt == request.time ||
             request.resource.data.createdAt == request.resource.data.get('createdAt', request.time);
    }
    
    // ============================================
    // USERS COLLECTION - Store user profiles
    // Structure: /users/{uid}
    // ============================================
    
    match /users/{uid} {
      // Only the user can read their own profile
      allow read: if isOwner(uid);
      
      // Users can create their own profile
      allow create: if isAuth() && uid == request.auth.uid && 
                       hasRequired(['uid', 'email']) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email;
      
      // Users can update their own profile
      allow update: if isOwner(uid) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']);
      
      // Users cannot delete their own profile (soft delete only)
      allow delete: if false;
      
      // ============================================
      // TODOS SUBCOLLECTION - User's todo items
      // ============================================
      
      match /todos/{todoId} {
        // Owner can read all their todos
        allow read: if isOwner(uid);
        
        // Owner can create todos with valid data
        allow create: if isOwner(uid) &&
                         hasRequired(['title', 'completed']) &&
                         request.resource.data.title is string &&
                         request.resource.data.title.size() > 0 &&
                         request.resource.data.title.size() <= 200 &&
                         request.resource.data.completed is bool &&
                         request.resource.data.uid == request.auth.uid;
        
        // Owner can update their own todos
        allow update: if isOwner(uid) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']);
        
        // Owner can delete their own todos
        allow delete: if isOwner(uid);
      }
      
      // ============================================
      // SAVED DESTINATIONS SUBCOLLECTION
      // ============================================
      
      match /savedDestinations/{destId} {
        // Owner can read their saved destinations
        allow read: if isOwner(uid);
        
        // Owner can save destinations
        allow create: if isOwner(uid) &&
                         hasRequired(['cityName']) &&
                         request.resource.data.cityName is string &&
                         request.resource.data.cityName.size() > 0 &&
                         request.resource.data.uid == request.auth.uid;
        
        // Owner can update their saved destinations
        allow update: if isOwner(uid) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'savedAt']);
        
        // Owner can delete their saved destinations
        allow delete: if isOwner(uid);
      }
      
      // ============================================
      // TRIPS SUBCOLLECTION - Trip plans
      // ============================================
      
      match /trips/{tripId} {
        // Owner can read their trips
        allow read: if isOwner(uid);
        
        // Owner can create trips with valid data
        allow create: if isOwner(uid) &&
                         hasRequired(['destination', 'startDate', 'endDate', 'budget', 'travelers']) &&
                         request.resource.data.destination is string &&
                         request.resource.data.startDate is string &&
                         request.resource.data.endDate is string &&
                         request.resource.data.budget is number &&
                         request.resource.data.budget > 0 &&
                         request.resource.data.travelers is number &&
                         request.resource.data.travelers > 0 &&
                         request.resource.data.status in ['planned', 'ongoing', 'completed'] &&
                         request.resource.data.uid == request.auth.uid;
        
        // Owner can update their trips
        allow update: if isOwner(uid) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']);
        
        // Owner can delete their trips
        allow delete: if isOwner(uid);
      }
      
      // ============================================
      // CATCH-ALL: Deny all other access
      // ============================================
      
      match /{document=**} {
        allow read, write: if false;
      }
    }
    
    // ============================================
    // PUBLIC COLLECTIONS (Optional)
    // ============================================
    
    // Public destinations data (read-only for all users)
    match /publicDestinations/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Catch-all: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
