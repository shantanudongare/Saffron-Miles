# =====================================
# ENVIRONMENT: Copy to .env and fill in your values
# =====================================
# DO NOT commit .env to Git! This file (.env.example) is safe to commit.
# To set up: cp .env.example .env and add your actual credentials

# =====================================
# DATABASE CONFIGURATION
# =====================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/?appName=Saffron-Miles

# =====================================
# GROQ API KEYS (Generative AI)
# =====================================
# Get free API keys from: https://console.groq.com/keys
# Budget Optimizer - separate key for rate limiting
GROQ_API_KEY_BUDGET=your_groq_api_key_budget_here

# Itinerary Planner - separate key for rate limiting
GROQ_API_KEY_ITINERARY=your_groq_api_key_itinerary_here

# AI Storyteller - main Groq API key
GROQ_API_KEY=your_groq_api_key_here

# NLP Chatbot API key
NLP_CHATBOT=your_groq_api_key_chatbot_here

# =====================================
# ELEVEN LABS - TEXT TO SPEECH
# =====================================
# Get API key from: https://elevenlabs.io/app/subscription
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# =====================================
# EMAIL CONFIGURATION (SMTP)
# =====================================
# Gmail: Use App Passwords (not your main password)
# Generate here: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# =====================================
# SMS CONFIGURATION (FAST2SMS)
# =====================================
# Get free API key from: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# =====================================
# WEATHER API (OpenWeatherMap)
# =====================================
# Get free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# =====================================
# FIREBASE CONFIGURATION
# =====================================
# Add your Firebase configuration details
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# =====================================
# APPLICATION SETTINGS
# =====================================
# Flask/FastAPI Debug mode (True for development, False for production)
DEBUG=False

# Application Environment
ENVIRONMENT=development
# development, production, testing

# Secret key for Flask sessions (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here_change_in_production

# =====================================
# NODE/VITE CONFIGURATION
# =====================================
# Vite environment - development or production
VITE_ENV=development

# API base URL
VITE_API_BASE_URL=http://localhost:5000
